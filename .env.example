# ==============================================================================
# SMART EMERGENCY RESPONSE NETWORK (SERN) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server Binding
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For local zero-config MVP, leave DB_ENGINE=sqlite to use backend/sern.db.
# For production municipal scale with PostGIS sub-millisecond geographic indexing:
DB_ENGINE=sqlite
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=sern_db

# Direct connection string override (optional)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sern_db

# ------------------------------------------------------------------------------
# REAL EMAIL NOTIFICATION GATEWAY (SMTP)
# ------------------------------------------------------------------------------
# Supports Gmail, Outlook, Brevo, AWS SES, or any standard SMTP service.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ------------------------------------------------------------------------------
# TWILIO / FAST2SMS LIVE SMS GATEWAYS
# ------------------------------------------------------------------------------
# Provide active Twilio credentials for international SMS or Fast2SMS for Indian numbers (+91).
# (If omitted, simulated fallback displays code instantly so evaluators are never blocked)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (FCM) MOBILE PUSH GATEWAY
# ------------------------------------------------------------------------------
# Provide Firebase Cloud Messaging server key to push live high-priority emergency
# alerts to trauma center mobile tablets and dispatch consoles.
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ------------------------------------------------------------------------------
# MACHINE LEARNING ENGINE
# ------------------------------------------------------------------------------
# Auto-dispatch nearest available ambulance immediately when an accident is confirmed
AUTO_DISPATCH_ON_VALIDATION=false
