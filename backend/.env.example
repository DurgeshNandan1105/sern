# SERN Backend Environment Configuration

# Application
APP_NAME="SERN - Smart Emergency Response Network"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated list of origins or wildcard)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Database Configuration
# Default: SQLite (file-based MVP)
DATABASE_URL=sqlite:///./sern.db

# For production MySQL, replace with:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sern_db

# ML Module Path (relative to backend directory or absolute path)
ML_MODEL_PATH=../AccidentDetectionML/models/accident_detection_final.pkl

# Dispatch Configuration
AUTO_DISPATCH_ON_VALIDATION=False

